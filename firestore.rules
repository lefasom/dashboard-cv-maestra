rules_version = '2';

// IMPORTANTE: si ya tenés un firestore.rules con otras colecciones,
// NO lo reemplaces entero. Copiá las funciones `eventoValido`, `resenaValida`
// `resenaEditadaValida`, `disenoFeedbackValido`, `mapaUno`, `cambioUnDiseno`
// y las del bloque USO AGREGADO (`usoEstructuraOk`, `usoCrearDelta`,
// `usoActualizarDelta`, `usoCrearOk`, `usoActualizarOk`), los 6 bloques
// `match /dashboard_.../{id}`, los 6 bloques
// `match /dashboard_config/...` (diseno_resets, diseno_contadores,
// uso_contadores, distribucion, versiones y versiones_historial) y el bloque
// `match /chats/{userId}` dentro de tu archivo actual.
//
// CAMBIOS DE ESTA VERSIÓN:
//   - NUEVO bloque `match /dashboard_config/versiones_historial` (archivo de
//     versiones vencidas: lo escribe y lo lee solo el dashboard; la app no
//     lo toca). Las versiones vencidas SIGUEN en `dashboard_config/versiones`
//     para que las APK viejas continúen bloqueadas.
//   - Bloque `match /dashboard_config/versiones` (control de versiones:
//     la app lee la fecha de vencimiento de su versión; el dashboard la
//     escribe). Es lo que usa el bloqueo de la app (utils/dateLock).
//   - Bloque `match /dashboard_config/uso_contadores` (métricas de uso
//     agregadas en un solo documento) y sus funciones auxiliares.
//   - `dashboard_profiles` y `dashboard_interactions` quedan DEPRECADOS (las
//     APK ya instaladas pueden seguir enviando esos eventos). No se borran
//     todavía.
// Hay que PUBLICAR las reglas en Firebase.

service cloud.firestore {
  match /databases/{database}/documents {

    // Un evento válido tiene siempre la misma forma:
    // { tipo, nombre, plataforma, createdAt, plantillaId?, extra? }
    function eventoValido(tipos) {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo', 'nombre', 'plataforma', 'createdAt', 'plantillaId', 'extra'])
        && d.keys().hasAll(['tipo', 'nombre', 'plataforma', 'createdAt'])
        && d.tipo in tipos
        && d.nombre is string
        && d.nombre.size() <= 120
        && d.plataforma is string
        && d.createdAt == request.time
        && (!('plantillaId' in d) || d.plantillaId is string)
        && (!('extra' in d) || d.extra is map);
    }

    // Reseña NUEVA:
    // { tipo, nombre, estrellas, texto, plataforma, createdAt, idioma?, chatId? }
    //   chatId = id anónimo del usuario (para poder borrar su reseña al
    //   limpiar el historial desde el dashboard)
    function resenaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo', 'nombre', 'estrellas', 'texto', 'plataforma', 'createdAt', 'idioma', 'chatId'])
        && d.keys().hasAll(['tipo', 'nombre', 'estrellas', 'texto', 'plataforma', 'createdAt'])
        && d.tipo == 'resena_enviada'
        && d.nombre is string
        && d.nombre.size() >= 1
        && d.nombre.size() <= 40
        && d.estrellas is int
        && d.estrellas >= 1
        && d.estrellas <= 5
        && d.texto is string
        && d.texto.size() <= 300
        && d.plataforma is string
        && d.plataforma.size() <= 20
        && d.createdAt == request.time
        && (!('idioma' in d) || (d.idioma is string && d.idioma.size() <= 5))
        && (!('chatId' in d) || (d.chatId is string && d.chatId.size() <= 60));
    }

    // Reseña EDITADA desde la app ("Cambiar reseña"): se puede cambiar
    // nombre, estrellas, texto e idioma. La fecha original (createdAt) y el
    // chatId no se pueden tocar.
    function resenaEditadaValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo', 'nombre', 'estrellas', 'texto', 'plataforma', 'createdAt', 'idioma', 'chatId', 'editadaEn'])
        && d.keys().hasAll(['tipo', 'nombre', 'estrellas', 'texto', 'plataforma', 'createdAt'])
        && d.tipo == 'resena_enviada'
        && d.nombre is string
        && d.nombre.size() >= 1
        && d.nombre.size() <= 40
        && d.estrellas is int
        && d.estrellas >= 1
        && d.estrellas <= 5
        && d.texto is string
        && d.texto.size() <= 300
        && d.plataforma is string
        && d.plataforma.size() <= 20
        && d.createdAt == resource.data.createdAt
        && d.get('chatId', null) == resource.data.get('chatId', null)
        && (!('idioma' in d) || (d.idioma is string && d.idioma.size() <= 5))
        && (!('editadaEn' in d) || d.editadaEn == request.time);
    }

    // "¿Te gustó el diseño?": like / dislike de un usuario sobre una plantilla.
    // { tipo, userId, nombre, plataforma, createdAt, idioma? }
    //   nombre = nombre del diseño en el catálogo (ej. "CV-06"), no el id.
    // El id del documento es `${userId}_${nombre}`: una respuesta por
    // usuario y diseño (no se puede crear dos veces ni editar).
    function disenoFeedbackValido(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo', 'nombre', 'plataforma', 'createdAt', 'userId', 'idioma'])
        && d.keys().hasAll(['tipo', 'nombre', 'plataforma', 'createdAt', 'userId'])
        && d.tipo in ['diseno_like', 'diseno_dislike']
        && d.nombre is string
        && d.nombre.size() >= 1
        && d.nombre.size() <= 100
        && d.plataforma is string
        && d.plataforma.size() <= 20
        && d.userId is string
        && d.userId.size() >= 10
        && d.userId.size() <= 60
        && d.createdAt == request.time
        && (!('idioma' in d) || (d.idioma is string && d.idioma.size() <= 5))
        && id == d.userId + '_' + d.nombre;
    }

    // Mapa con exactamente un diseño y el valor 1: {"CV-06": 1}
    // (lo usa el contador de likes / dislikes, ver más abajo)
    function mapaUno(m) {
      return m.size() == 1 && m.values()[0] == 1;
    }

    // En una actualización desde la app, el mapa cambió en UN solo diseño
    function cambioUnDiseno(nuevo, viejo) {
      return nuevo.diff(viejo).affectedKeys().size() == 1;
    }

    // ============================================================
    // USO AGREGADO (dashboard_config/uso_contadores)
    //
    // La app (sin sesión) envía UNA escritura en bloque con
    // setDoc(..., { merge: true }) + increment(n). Lo que llega acá es el
    // documento YA MEZCLADO, por eso se compara contra el existente.
    //
    // Estructura (exactamente estas claves, nada más):
    //   uso:     paginacion_cambiada, editor_abierto, wizard_usado,
    //            perfil_nuevo_inicio, perfil_nuevo_mis_perfiles,
    //            perfil_activado_prueba, perfil_activado_real
    //   editor:  imagen, experiencia, datos, tamano, desplazar, vista
    //   tamanos: x0_9, x1_0, x1_1, x1_2, x1_3
    //   ajustes: abierto, idioma_cambiado, modo_oscuro_on, modo_oscuro_off,
    //            compartir, acerca_de, terminos
    //   idiomas: es, en, pt
    //
    // Cada valor es int y el DELTA respecto del documento existente es
    // >= 0 y <= 1000 por escritura (en create se compara contra 0).
    //
    // OJO: sin autenticación estas reglas NO pueden impedir que alguien
    // suba números falsos (solo limitan el daño por escritura: máximo 1000
    // por clave). Endurecimiento futuro: Firebase App Check.
    //
    // Reglas no permite bucles: hay una llamada explícita por clave.
    // ============================================================

    // Primer nivel y claves de cada grupo (exactamente las del modelo)
    function usoEstructuraOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uso', 'editor', 'tamanos', 'ajustes', 'idiomas'])
        && d.get('uso', {}) is map
        && d.get('editor', {}) is map
        && d.get('tamanos', {}) is map
        && d.get('ajustes', {}) is map
        && d.get('idiomas', {}) is map
        && d.get('uso', {}).keys().hasOnly([
          'paginacion_cambiada', 'editor_abierto', 'wizard_usado',
          'perfil_nuevo_inicio', 'perfil_nuevo_mis_perfiles',
          'perfil_activado_prueba', 'perfil_activado_real'
        ])
        && d.get('editor', {}).keys().hasOnly([
          'imagen', 'experiencia', 'datos', 'tamano', 'desplazar', 'vista'
        ])
        && d.get('tamanos', {}).keys().hasOnly([
          'x0_9', 'x1_0', 'x1_1', 'x1_2', 'x1_3'
        ])
        && d.get('ajustes', {}).keys().hasOnly([
          'abierto', 'idioma_cambiado', 'modo_oscuro_on', 'modo_oscuro_off',
          'compartir', 'acerca_de', 'terminos'
        ])
        && d.get('idiomas', {}).keys().hasOnly(['es', 'en', 'pt']);
    }

    // CREATE: el valor nuevo es int entre 0 y 1000 (se compara contra 0)
    function usoCrearDelta(g, k) {
      let n = request.resource.data.get(g, {}).get(k, 0);
      return n is int && n >= 0 && n <= 1000;
    }

    // UPDATE: el valor nuevo menos el existente es int entre 0 y 1000
    function usoActualizarDelta(g, k) {
      let n = request.resource.data.get(g, {}).get(k, 0);
      let v = resource.data.get(g, {}).get(k, 0);
      return n is int && v is int && n - v >= 0 && n - v <= 1000;
    }

    function usoCrearOk() {
      return usoEstructuraOk()
        // uso
        && usoCrearDelta('uso', 'paginacion_cambiada')
        && usoCrearDelta('uso', 'editor_abierto')
        && usoCrearDelta('uso', 'wizard_usado')
        && usoCrearDelta('uso', 'perfil_nuevo_inicio')
        && usoCrearDelta('uso', 'perfil_nuevo_mis_perfiles')
        && usoCrearDelta('uso', 'perfil_activado_prueba')
        && usoCrearDelta('uso', 'perfil_activado_real')
        // editor
        && usoCrearDelta('editor', 'imagen')
        && usoCrearDelta('editor', 'experiencia')
        && usoCrearDelta('editor', 'datos')
        && usoCrearDelta('editor', 'tamano')
        && usoCrearDelta('editor', 'desplazar')
        && usoCrearDelta('editor', 'vista')
        // tamanos
        && usoCrearDelta('tamanos', 'x0_9')
        && usoCrearDelta('tamanos', 'x1_0')
        && usoCrearDelta('tamanos', 'x1_1')
        && usoCrearDelta('tamanos', 'x1_2')
        && usoCrearDelta('tamanos', 'x1_3')
        // ajustes
        && usoCrearDelta('ajustes', 'abierto')
        && usoCrearDelta('ajustes', 'idioma_cambiado')
        && usoCrearDelta('ajustes', 'modo_oscuro_on')
        && usoCrearDelta('ajustes', 'modo_oscuro_off')
        && usoCrearDelta('ajustes', 'compartir')
        && usoCrearDelta('ajustes', 'acerca_de')
        && usoCrearDelta('ajustes', 'terminos')
        // idiomas
        && usoCrearDelta('idiomas', 'es')
        && usoCrearDelta('idiomas', 'en')
        && usoCrearDelta('idiomas', 'pt');
    }

    function usoActualizarOk() {
      return usoEstructuraOk()
        // uso
        && usoActualizarDelta('uso', 'paginacion_cambiada')
        && usoActualizarDelta('uso', 'editor_abierto')
        && usoActualizarDelta('uso', 'wizard_usado')
        && usoActualizarDelta('uso', 'perfil_nuevo_inicio')
        && usoActualizarDelta('uso', 'perfil_nuevo_mis_perfiles')
        && usoActualizarDelta('uso', 'perfil_activado_prueba')
        && usoActualizarDelta('uso', 'perfil_activado_real')
        // editor
        && usoActualizarDelta('editor', 'imagen')
        && usoActualizarDelta('editor', 'experiencia')
        && usoActualizarDelta('editor', 'datos')
        && usoActualizarDelta('editor', 'tamano')
        && usoActualizarDelta('editor', 'desplazar')
        && usoActualizarDelta('editor', 'vista')
        // tamanos
        && usoActualizarDelta('tamanos', 'x0_9')
        && usoActualizarDelta('tamanos', 'x1_0')
        && usoActualizarDelta('tamanos', 'x1_1')
        && usoActualizarDelta('tamanos', 'x1_2')
        && usoActualizarDelta('tamanos', 'x1_3')
        // ajustes
        && usoActualizarDelta('ajustes', 'abierto')
        && usoActualizarDelta('ajustes', 'idioma_cambiado')
        && usoActualizarDelta('ajustes', 'modo_oscuro_on')
        && usoActualizarDelta('ajustes', 'modo_oscuro_off')
        && usoActualizarDelta('ajustes', 'compartir')
        && usoActualizarDelta('ajustes', 'acerca_de')
        && usoActualizarDelta('ajustes', 'terminos')
        // idiomas
        && usoActualizarDelta('idiomas', 'es')
        && usoActualizarDelta('idiomas', 'en')
        && usoActualizarDelta('idiomas', 'pt');
    }

    // Plantillas: descargas de PDF y agregadas a la colección
    match /dashboard_events/{id} {
      allow create: if eventoValido(['plantilla_descargada', 'plantilla_biblioteca']);
      allow read: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Onboarding (experiencia mejorada)
    //   onboarding_completado  → se activó la experiencia mejorada
    //   onboarding_admin_uso   → uso del Admin y de cada botón Editar
    //   (onboarding_editado / onboarding_desactivado se mantienen
    //    permitidos por compatibilidad, hoy la app no los envía)
    match /dashboard_onboarding/{id} {
      allow create: if eventoValido([
        'onboarding_completado',
        'onboarding_editado',
        'onboarding_desactivado',
        'onboarding_admin_uso'
      ]);
      allow read: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Perfiles — DEPRECADO.
    // Reemplazado por dashboard_config/uso_contadores. Se deja habilitado
    // solo para que las APK ya instaladas no reciban errores; se puede
    // borrar este bloque cuando ya no queden versiones viejas en uso.
    match /dashboard_profiles/{id} {
      allow create: if eventoValido([
        'perfil_prueba_seleccionado',
        'perfil_prueba_activado',
        'perfil_real_creado'
      ]);
      allow read: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Uso / interacciones — DEPRECADO.
    // Reemplazado por dashboard_config/uso_contadores. Mismo criterio que
    // dashboard_profiles: se borra cuando ya no queden APK viejas.
    match /dashboard_interactions/{id} {
      allow create: if eventoValido([
        'paginacion_cambiada',
        'editor_abierto',
        'desplazamiento_cambiado'
      ]);
      allow read: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Reseñas (las envía y edita la app, las lee y borra el dashboard)
    match /dashboard_reviews/{id} {
      allow create: if resenaValida();
      allow read: if request.auth != null;
      allow update: if resenaEditadaValida();   // "Cambiar reseña" en la app
      allow delete: if request.auth != null;     // Historial / Restablecer datos
    }

    // Likes / dislikes de diseños (los envía la app, los lee y borra el dashboard)
    match /dashboard_design_feedback/{id} {
      allow create: if disenoFeedbackValido(id);
      allow read: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // ============================================================
    // CONFIGURACIÓN (dashboard_config)
    //
    //   diseno_resets      marcas de "reiniciar me gusta / no me gusta".
    //                      Las escribe el dashboard (con sesión) y las leen
    //                      los teléfonos (sin sesión) por id, para borrar
    //                      sus respuestas guardadas y volver a preguntar.
    //
    //   diseno_contadores  { likes: { "CV-06": 4 }, dislikes: { "CV-06": 1 } }
    //                      La app solo SUMA votos; el dashboard lo lee (una
    //                      sola lectura) y lo reinicia.
    //
    //   uso_contadores     métricas de uso agregadas (ver bloque USO
    //                      AGREGADO más arriba). La app solo SUMA (create /
    //                      update, nunca delete); el dashboard lo lee (una
    //                      sola lectura) y lo reinicia.
    //
    //   distribucion       cómo se comparte la app (Ajustes > Compartir
    //                      aplicación). La app solo LEE; el dashboard escribe.
    //                      { modoDistribucion: "apk" | "play",
    //                        urlApk, urlPlay,
    //                        mensajeCompartir: { es, en, pt } }
    //                      También es el enlace que abre el botón "Actualizar
    //                      aplicación" de la pantalla de bloqueo.
    //
    //   versiones          control de versiones y bloqueo de la app. La app
    //                      solo LEE; el dashboard (pestaña Versiones) escribe.
    //                      { versiones: [
    //                          { version: "1.3.0",
    //                            lanzamiento: "2026-10-01",
    //                            vencimiento: "2027-09-30" }, ... ],
    //                        actualizadoEn }
    //                      La app usa la fecha de vencimiento de SU versión
    //                      (la de app.json) y la compara con la fecha del
    //                      teléfono. Las versiones vencidas se quedan acá
    //                      para que las APK viejas sigan bloqueadas.
    //
    //   versiones_historial archivo de versiones vencidas (pestaña Versiones,
    //                      sección Historial). Solo lo usa el dashboard: la
    //                      app NO lo lee ni lo escribe. Es un objeto (mapa
    //                      por versión), no una lista:
    //                      { registros: {
    //                          v_1_0_0: { version: "1.0.0",
    //                                     lanzamiento: "2026-01-15",
    //                                     vencimiento: "2026-06-30",
    //                                     archivadoEn: "2026-10-26" }, ... },
    //                        actualizadoEn }
    // ============================================================

    match /dashboard_config/diseno_resets {
      allow get: if true;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['resetTodoEn', 'resets', 'actualizadoEn'])
        && request.resource.data.get('resetTodoEn', 0) is number
        && request.resource.data.get('resets', {}) is map;

      allow delete: if request.auth != null;
    }

    match /dashboard_config/diseno_contadores {
      // Solo el dashboard lee
      allow get: if request.auth != null;

      // Dashboard (con sesión): cualquier cambio (reiniciar, recalcular)
      allow create, update, delete: if request.auth != null;

      // App (sin sesión): solo sumar votos
      // - primer voto: se crea el documento con un solo diseño en 1
      allow create: if
        (request.resource.data.keys().hasOnly(['likes'])
          && mapaUno(request.resource.data.likes))
        || (request.resource.data.keys().hasOnly(['dislikes'])
          && mapaUno(request.resource.data.dislikes));

      // - siguientes votos: cambia un solo diseño, de un solo mapa
      allow update: if request.resource.data.keys().hasOnly(['likes', 'dislikes'])
        && (
          (cambioUnDiseno(request.resource.data.get('likes', {}), resource.data.get('likes', {}))
            && request.resource.data.get('dislikes', {}) == resource.data.get('dislikes', {}))
          ||
          (cambioUnDiseno(request.resource.data.get('dislikes', {}), resource.data.get('dislikes', {}))
            && request.resource.data.get('likes', {}) == resource.data.get('likes', {}))
        );
    }

    // Métricas de uso agregadas.
    match /dashboard_config/uso_contadores {
      // Solo el dashboard lee
      allow get: if request.auth != null;

      // Dashboard (con sesión): cualquier cambio (reiniciar desde Historial)
      allow create, update, delete: if request.auth != null;

      // App (sin sesión): solo sumar, nunca borrar
      allow create: if usoCrearOk();
      allow update: if usoActualizarOk();
    }

    // Distribución de la app: la app (sin sesión) lee por id,
    // solo el dashboard (con sesión) escribe.
    match /dashboard_config/distribucion {
      allow get: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Control de versiones: la app (sin sesión) lee por id, solo el
    // dashboard (con sesión) escribe. Se acepta únicamente `versiones`
    // (lista, máx. 200 entradas) y `actualizadoEn`.
    match /dashboard_config/versiones {
      allow get: if true;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['versiones', 'actualizadoEn'])
        && request.resource.data.get('versiones', []) is list
        && request.resource.data.get('versiones', []).size() <= 200;

      allow delete: if request.auth != null;
    }

    // Historial de versiones vencidas: solo el dashboard (con sesión) lee y
    // escribe. La app no tiene acceso. Se acepta únicamente `registros`
    // (mapa, máx. 200 entradas) y `actualizadoEn`.
    match /dashboard_config/versiones_historial {
      allow get: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['registros', 'actualizadoEn'])
        && request.resource.data.get('registros', {}) is map
        && request.resource.data.get('registros', {}).size() <= 200;

      allow delete: if request.auth != null;
    }

    // ============================================================
    // CHAT DE AYUDA
    //
    //   chats/{userId}                  ficha del usuario (presencia)
    //   chats/{userId}/messages/{id}    mensajes de ambos lados
    //   chats/{userId}/limites/{dia}    contador de mensajes por día
    //
    // Campos de la ficha:
    //   Los escribe la APP:      creadoEn, ultimaVez (en el chat), enChat,
    //                            ultimaVezApp, enApp (dentro de la app),
    //                            plataforma, idioma, ultimoMensaje,
    //                            ultimoMensajeEn
    //   Los escribe el DASHBOARD: soporteLeyoHasta, ultimaRespuestaEn,
    //                            resetEn (la app los puede dejar igual,
    //                            nunca cambiarlos)
    // ============================================================

    match /chats/{userId} {

      function camposApp() {
        return ['creadoEn', 'ultimaVez', 'ultimaVezApp', 'enChat', 'enApp',
                'plataforma', 'idioma', 'ultimoMensaje', 'ultimoMensajeEn'];
      }

      function camposSoporte() {
        return ['soporteLeyoHasta', 'ultimaRespuestaEn', 'resetEn'];
      }

      // La app no puede tocar los campos del soporte
      function soporteIntacto() {
        return request.resource.data.get('soporteLeyoHasta', null) == resource.data.get('soporteLeyoHasta', null)
          && request.resource.data.get('ultimaRespuestaEn', null) == resource.data.get('ultimaRespuestaEn', null)
          && request.resource.data.get('resetEn', null) == resource.data.get('resetEn', null);
      }

      // La app lee solo SU ficha (por id). Listar todos: solo el dashboard.
      allow get: if true;
      allow list: if request.auth != null;

      // La app crea su ficha
      allow create: if request.resource.data.keys().hasOnly(camposApp())
        && userId.size() >= 10 && userId.size() <= 60;

      // La app actualiza su ficha (sin tocar los campos del soporte)
      allow update: if request.resource.data.keys().hasOnly(camposApp().concat(camposSoporte()))
        && soporteIntacto();

      // Dashboard (con sesión): cualquier campo
      allow create, update: if request.auth != null;

      // Solo el dashboard puede borrar
      allow delete: if request.auth != null;

      // Mensajes
      match /messages/{mensajeId} {
        allow read: if true;

        // Del usuario (app): máx. 500 caracteres y máx. 10 por día
        allow create: if request.resource.data.keys().hasOnly(
              ['de', 'texto', 'enviadoEn', 'dia', 'createdAt'])
          && request.resource.data.keys().hasAll(
              ['de', 'texto', 'enviadoEn', 'dia', 'createdAt'])
          && request.resource.data.de == 'usuario'
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 500
          && request.resource.data.enviadoEn is number
          && request.resource.data.dia is string
          && request.resource.data.dia.size() == 10
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/chats/$(userId)/limites/$(request.resource.data.dia)).data.count <= 10;

        // Tuyos (dashboard con sesión): sin límite diario
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(
              ['de', 'texto', 'enviadoEn', 'createdAt'])
          && request.resource.data.keys().hasAll(
              ['de', 'texto', 'enviadoEn'])
          && request.resource.data.de == 'soporte'
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 2000
          && request.resource.data.enviadoEn is number;

        // Editar tus propios mensajes (dashboard con sesión):
        // solo los de 'soporte'. Se puede cambiar el texto y se marca
        // con editadoEn. El autor y las fechas originales no se tocan.
        allow update: if request.auth != null
          && resource.data.de == 'soporte'
          && request.resource.data.de == 'soporte'
          && request.resource.data.keys().hasOnly(
              ['de', 'texto', 'enviadoEn', 'createdAt', 'editadoEn'])
          && request.resource.data.keys().hasAll(
              ['de', 'texto', 'enviadoEn', 'editadoEn'])
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 2000
          && request.resource.data.enviadoEn == resource.data.enviadoEn
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && request.resource.data.editadoEn is number;

        allow delete: if request.auth != null;
      }

      // Contador diario: solo sube de a 1 y hasta 10
      match /limites/{dia} {
        allow read: if request.auth != null;

        allow create: if request.resource.data.keys().hasOnly(['count', 'dia'])
          && request.resource.data.count == 1
          && request.resource.data.dia == dia;

        allow update: if request.resource.data.keys().hasOnly(['count', 'dia'])
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.count <= 10
          && request.resource.data.dia == dia;

        allow delete: if request.auth != null;
      }
    }
  }
}
