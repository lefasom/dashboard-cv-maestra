rules_version = '2';

// IMPORTANTE: si ya tenés un firestore.rules con otras colecciones,
// NO lo reemplaces entero. Copiá las funciones `eventoValido`,
// `disenoFeedbackValido`, `mapaUno`, `cambioUnDiseno`,
// las del bloque USO AGREGADO (`usoDeltaOk`, `usoDelta`, `usoGrupoUso`,
// `usoGrupoEditor`, `usoGrupoTamanos`, `usoGrupoAjustes`, `usoGrupoIdiomas`,
// `usoCrearOk`, `usoActualizarOk`), las de ENCUESTAS COMPARTIDAS
// (`cmpDelta`, `cmpClaveOk`, `cmpVotoOk`), los 5 bloques
// `match /dashboard_.../{id}`, los 7 bloques
// `match /dashboard_config/...` y `match /dashboard_mensajes_.../{id}`
// (diseno_resets, diseno_contadores, uso_contadores, distribucion, versiones,
// versiones_historial, mensajes_modulos, mensajes_plantillas, mensajes_envios
// y mensajes_compartidos) y el bloque `match /chats/{userId}` dentro de tu
// archivo actual.
//
// CAMBIOS DE ESTA VERSIÓN (12/11/2026: mensajes en 3 idiomas, sin reseñas):
//   - Se ELIMINAN las reseñas: el bloque `match /dashboard_reviews/{id}` y
//     las funciones `resenaValida` / `resenaEditadaValida`. Sin bloque, la
//     colección queda cerrada (nadie lee ni escribe). Los documentos viejos
//     se pueden borrar a mano desde la consola de Firebase.
//   - chats/{id}/messages: los mensajes del soporte pueden traer `idioma`
//     = { es, en, pt } (strings, en/pt pueden ir vacíos). `texto` sigue
//     siendo el español. Editar puede cambiar `texto` e `idioma`.
//   - Los mensajes personalizados guardan las traducciones DENTRO de `rico`
//     (`rico.idioma = { en: {...}, pt: {...} }`), así que plantillas,
//     envíos y encuestas compartidas no necesitan reglas nuevas.
//
// CAMBIOS DE LA VERSIÓN ANTERIOR (encuestas compartidas):
//   - Bloque nuevo `match /dashboard_mensajes_compartidos/{id}`: la tabla
//     donde vive cada encuesta (me gusta / ranking) UNA sola vez, con sus
//     contadores. La app (sin sesión) la LEE por id y solo puede MOVER votos
//     en `contadores` (voto nuevo = una clave +1; cambiar de voto = una clave
//     -1 y otra +1). El dashboard (con sesión) puede todo.
//     Funciones nuevas: `cmpDelta`, `cmpClaveOk`, `cmpVotoOk`.
//   - chats/{id}/messages: el soporte (dashboard) ahora puede guardar el
//     campo `refId` (referencia a la encuesta compartida). `ricoValido`
//     acepta tres formas de mensaje:
//        1) sin `modo` / `rico` / `refId`        (texto simple)
//        2) `modo` + `rico`, sin `refId`          (texto, tarjeta, video y
//                                                  encuestas VIEJAS)
//        3) `modo` de encuesta + `refId`, sin `rico` (encuesta compartida)
//     Editar un mensaje no puede cambiar `modo`, `rico` ni `refId`.
//
// CAMBIOS DE LA VERSIÓN ANTERIOR (registro de envíos masivos):
//   - Bloque `match /dashboard_mensajes_envios/{id}`: registro de los
//     mensajes enviados a varios chats, para poder borrarlos de todos con un
//     botón desde el dashboard. Solo el dashboard (con sesión); la app de
//     React Native no lo lee ni lo escribe.
//   - Los mensajes de un envío masivo llevan el mismo id (`env_<envioId>`)
//     en cada chat; las reglas de chats/{id}/messages ya permiten crear con
//     id propio y borrar.
//
// CAMBIOS DE LA VERSIÓN ANTERIOR (mensajes personalizados del chat):
//   - chats/{id}/messages: el soporte (dashboard) puede agregar los campos
//     `modo` y `rico` (tarjeta, video, encuestas, texto con formato). La
//     función `ricoValido` (dentro de `match /chats/{userId}`) los valida.
//     Los mensajes de la APP no pueden traerlos.
//   - Bloque `match /dashboard_mensajes_plantillas/{id}`: mensajes
//     guardados con nombre. Solo el dashboard (con sesión).
//   - Bloque `match /dashboard_config/mensajes_modulos`: interruptores
//     de módulos y demos. La app (sin sesión) lee; el dashboard escribe.
//
// CAMBIOS DE LAS VERSIONES MÁS VIEJAS:
//   - USO AGREGADO: CREATE y UPDATE gastan muchísimas menos expresiones
//     (Firestore rechazaba con permission-denied cuando se rozaba el límite
//     de ~1.000 expresiones por pedido). Solo se validan los grupos y las
//     claves que la escritura CAMBIA.
//   - Bloque `match /dashboard_config/versiones_historial` (archivo de
//     versiones vencidas: lo escribe y lo lee solo el dashboard).
//   - Bloque `match /dashboard_config/versiones` (control de versiones:
//     la app lee la fecha de vencimiento de su versión; el dashboard la
//     escribe). Es lo que usa el bloqueo de la app (utils/dateLock).
//   - Bloque `match /dashboard_config/uso_contadores` (métricas de uso
//     agregadas en un solo documento) y sus funciones auxiliares.
//   - `dashboard_profiles` y `dashboard_interactions` quedan DEPRECADOS (las
//     APK ya instaladas pueden seguir enviando esos eventos). No se borran
//     todavía.
// Hay que PUBLICAR las reglas en Firebase.

service cloud.firestore {
  match /databases/{database}/documents {

    // Un evento válido tiene siempre la misma forma:
    // { tipo, nombre, plataforma, createdAt, plantillaId?, extra? }
    function eventoValido(tipos) {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo', 'nombre', 'plataforma', 'createdAt', 'plantillaId', 'extra'])
        && d.keys().hasAll(['tipo', 'nombre', 'plataforma', 'createdAt'])
        && d.tipo in tipos
        && d.nombre is string
        && d.nombre.size() <= 120
        && d.plataforma is string
        && d.createdAt == request.time
        && (!('plantillaId' in d) || d.plantillaId is string)
        && (!('extra' in d) || d.extra is map);
    }

    // "¿Te gustó el diseño?": like / dislike de un usuario sobre una plantilla.
    // { tipo, userId, nombre, plataforma, createdAt, idioma? }
    //   nombre = nombre del diseño en el catálogo (ej. "CV-06"), no el id.
    // El id del documento es `${userId}_${nombre}`: una respuesta por
    // usuario y diseño (no se puede crear dos veces ni editar).
    function disenoFeedbackValido(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['tipo', 'nombre', 'plataforma', 'createdAt', 'userId', 'idioma'])
        && d.keys().hasAll(['tipo', 'nombre', 'plataforma', 'createdAt', 'userId'])
        && d.tipo in ['diseno_like', 'diseno_dislike']
        && d.nombre is string
        && d.nombre.size() >= 1
        && d.nombre.size() <= 100
        && d.plataforma is string
        && d.plataforma.size() <= 20
        && d.userId is string
        && d.userId.size() >= 10
        && d.userId.size() <= 60
        && d.createdAt == request.time
        && (!('idioma' in d) || (d.idioma is string && d.idioma.size() <= 5))
        && id == d.userId + '_' + d.nombre;
    }

    // Mapa con exactamente un diseño y el valor 1: {"CV-06": 1}
    // (lo usa el contador de likes / dislikes, ver más abajo)
    function mapaUno(m) {
      return m.size() == 1 && m.values()[0] == 1;
    }

    // En una actualización desde la app, el mapa cambió en UN solo diseño
    function cambioUnDiseno(nuevo, viejo) {
      return nuevo.diff(viejo).affectedKeys().size() == 1;
    }

    // ============================================================
    // USO AGREGADO (dashboard_config/uso_contadores)
    //
    // La app (sin sesión) envía UNA escritura en bloque con
    // setDoc(..., { merge: true }) + increment(n). Lo que llega acá es el
    // documento YA MEZCLADO, por eso se compara contra el existente.
    //
    // Estructura (exactamente estas claves, nada más):
    //   uso:     paginacion_cambiada, editor_abierto, wizard_usado,
    //            perfil_nuevo_inicio, perfil_nuevo_mis_perfiles,
    //            perfil_activado_prueba, perfil_activado_real
    //   editor:  imagen, experiencia, datos, tamano, desplazar, vista
    //   tamanos: x0_9, x1_0, x1_1, x1_2, x1_3
    //   ajustes: abierto, idioma_cambiado, modo_oscuro_on, modo_oscuro_off,
    //            compartir, acerca_de, terminos
    //   idiomas: es, en, pt
    //
    // Cada valor es int y el DELTA respecto del documento existente es
    // >= 0 y <= 1000 por escritura (en create se compara contra 0).
    //
    // POR QUÉ ESTÁ ARMADO ASÍ (límite de Firestore: 1.000 expresiones
    // evaluadas por pedido):
    //     1) Solo se revisan los GRUPOS que la escritura cambia.
    //     2) Dentro de un grupo, solo se revisa el delta de las CLAVES que
    //        cambian (`!(k in ch) || ...`).
    //     3) CREATE y UPDATE usan los mismos validadores de grupo: en
    //        CREATE el grupo "existente" es `{}`.
    //
    // Parámetros de los validadores de grupo:
    //   n  = el grupo en el documento NUEVO (ya mezclado)
    //   v  = el mismo grupo en el documento EXISTENTE (`{}` en create)
    //
    // OJO: sin autenticación estas reglas NO pueden impedir que alguien
    // suba números falsos (solo limitan el daño por escritura: máximo 1000
    // por clave). Endurecimiento futuro: Firebase App Check.
    // ============================================================

    // El delta (entero) está entre 0 y 1000
    function usoDeltaOk(x) {
      return x is int && x >= 0 && x <= 1000;
    }

    // `ch` = claves del grupo que la escritura cambia. Si la clave `k` no
    // cambia, no se evalúa nada más (corta enseguida).
    function usoDelta(n, v, ch, k) {
      return !(k in ch) || usoDeltaOk(n.get(k, 0) - v.get(k, 0));
    }

    function usoGrupoUso(n, v) {
      let ch = n.diff(v).affectedKeys();
      return n is map
        && v is map
        && ch.hasOnly([
          'paginacion_cambiada', 'editor_abierto', 'wizard_usado',
          'perfil_nuevo_inicio', 'perfil_nuevo_mis_perfiles',
          'perfil_activado_prueba', 'perfil_activado_real'
        ])
        && usoDelta(n, v, ch, 'paginacion_cambiada')
        && usoDelta(n, v, ch, 'editor_abierto')
        && usoDelta(n, v, ch, 'wizard_usado')
        && usoDelta(n, v, ch, 'perfil_nuevo_inicio')
        && usoDelta(n, v, ch, 'perfil_nuevo_mis_perfiles')
        && usoDelta(n, v, ch, 'perfil_activado_prueba')
        && usoDelta(n, v, ch, 'perfil_activado_real');
    }

    function usoGrupoEditor(n, v) {
      let ch = n.diff(v).affectedKeys();
      return n is map
        && v is map
        && ch.hasOnly([
          'imagen', 'experiencia', 'datos', 'tamano', 'desplazar', 'vista'
        ])
        && usoDelta(n, v, ch, 'imagen')
        && usoDelta(n, v, ch, 'experiencia')
        && usoDelta(n, v, ch, 'datos')
        && usoDelta(n, v, ch, 'tamano')
        && usoDelta(n, v, ch, 'desplazar')
        && usoDelta(n, v, ch, 'vista');
    }

    function usoGrupoTamanos(n, v) {
      let ch = n.diff(v).affectedKeys();
      return n is map
        && v is map
        && ch.hasOnly(['x0_9', 'x1_0', 'x1_1', 'x1_2', 'x1_3'])
        && usoDelta(n, v, ch, 'x0_9')
        && usoDelta(n, v, ch, 'x1_0')
        && usoDelta(n, v, ch, 'x1_1')
        && usoDelta(n, v, ch, 'x1_2')
        && usoDelta(n, v, ch, 'x1_3');
    }

    function usoGrupoAjustes(n, v) {
      let ch = n.diff(v).affectedKeys();
      return n is map
        && v is map
        && ch.hasOnly([
          'abierto', 'idioma_cambiado', 'modo_oscuro_on', 'modo_oscuro_off',
          'compartir', 'acerca_de', 'terminos'
        ])
        && usoDelta(n, v, ch, 'abierto')
        && usoDelta(n, v, ch, 'idioma_cambiado')
        && usoDelta(n, v, ch, 'modo_oscuro_on')
        && usoDelta(n, v, ch, 'modo_oscuro_off')
        && usoDelta(n, v, ch, 'compartir')
        && usoDelta(n, v, ch, 'acerca_de')
        && usoDelta(n, v, ch, 'terminos');
    }

    function usoGrupoIdiomas(n, v) {
      let ch = n.diff(v).affectedKeys();
      return n is map
        && v is map
        && ch.hasOnly(['es', 'en', 'pt'])
        && usoDelta(n, v, ch, 'es')
        && usoDelta(n, v, ch, 'en')
        && usoDelta(n, v, ch, 'pt');
    }

    // CREATE (el documento todavía no existe): los primeros niveles deben
    // ser solo los 5 grupos, y cada grupo presente se valida contra `{}`.
    function usoCrearOk() {
      let d = request.resource.data;
      let top = d.keys();
      return top.hasOnly(['uso', 'editor', 'tamanos', 'ajustes', 'idiomas'])
        && (!('uso' in top) || usoGrupoUso(d.get('uso', {}), {}))
        && (!('editor' in top) || usoGrupoEditor(d.get('editor', {}), {}))
        && (!('tamanos' in top) || usoGrupoTamanos(d.get('tamanos', {}), {}))
        && (!('ajustes' in top) || usoGrupoAjustes(d.get('ajustes', {}), {}))
        && (!('idiomas' in top) || usoGrupoIdiomas(d.get('idiomas', {}), {}));
    }

    // UPDATE (el documento ya existe): solo se revisan los grupos que la
    // escritura cambia, comparados contra el documento existente.
    function usoActualizarOk() {
      let d = request.resource.data;
      let r = resource.data;
      let top = d.diff(r).affectedKeys();
      return top.hasOnly(['uso', 'editor', 'tamanos', 'ajustes', 'idiomas'])
        && (!('uso' in top) || usoGrupoUso(d.get('uso', {}), r.get('uso', {})))
        && (!('editor' in top) || usoGrupoEditor(d.get('editor', {}), r.get('editor', {})))
        && (!('tamanos' in top) || usoGrupoTamanos(d.get('tamanos', {}), r.get('tamanos', {})))
        && (!('ajustes' in top) || usoGrupoAjustes(d.get('ajustes', {}), r.get('ajustes', {})))
        && (!('idiomas' in top) || usoGrupoIdiomas(d.get('idiomas', {}), r.get('idiomas', {})));
    }

    // ============================================================
    // ENCUESTAS COMPARTIDAS (dashboard_mensajes_compartidos)
    //
    // Cada encuesta (me gusta / ranking) vive acá UNA sola vez:
    //   { nombre, texto, modo, rico: { tipo, pregunta, opciones? },
    //     contadores: { ... }, creadoEn, enviadoEn }
    //   contadores:
    //     encuesta_likes -> { me_gusta: n, no_me_gusta: n }
    //     encuesta_top   -> { a: n, b: n, c: n, d: n, e: n, f: n }
    //
    // La app (sin sesión) solo puede MOVER votos en `contadores`:
    //   - voto nuevo:       una clave +1
    //   - cambiar de voto:  una clave -1 y otra +1
    // Es decir: cada clave cambia como mucho ±1, nunca queda negativa y la
    // SUMA de los cambios es 0 o 1 (nunca se puede sumar de a más de 1).
    //
    // Claves permitidas: me_gusta, no_me_gusta (likes) y a..f (ranking,
    // máximo 6 opciones). Son 8 claves fijas porque las reglas no tienen
    // bucles; el costo es chico (~100 expresiones, muy lejos del límite).
    // ============================================================

    // Cambio (nuevo - viejo) de una clave de `contadores`
    function cmpDelta(n, v, k) {
      return n.get(k, 0) - v.get(k, 0);
    }

    // La clave es un entero >= 0 y cambió como mucho en 1 hacia cualquier lado
    function cmpClaveOk(n, v, k) {
      return n.get(k, 0) is int
        && n.get(k, 0) >= 0
        && cmpDelta(n, v, k) >= -1
        && cmpDelta(n, v, k) <= 1;
    }

    // Escritura de la app: solo `contadores`, solo esas 8 claves, y movimiento
    // de votos válido (suma de cambios entre 0 y 1)
    function cmpVotoOk() {
      let n = request.resource.data.get('contadores', {});
      let v = resource.data.get('contadores', {});
      let suma = cmpDelta(n, v, 'me_gusta') + cmpDelta(n, v, 'no_me_gusta')
        + cmpDelta(n, v, 'a') + cmpDelta(n, v, 'b') + cmpDelta(n, v, 'c')
        + cmpDelta(n, v, 'd') + cmpDelta(n, v, 'e') + cmpDelta(n, v, 'f');

      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contadores'])
        && n is map
        && n.diff(v).affectedKeys().hasOnly(
            ['me_gusta', 'no_me_gusta', 'a', 'b', 'c', 'd', 'e', 'f'])
        && cmpClaveOk(n, v, 'me_gusta')
        && cmpClaveOk(n, v, 'no_me_gusta')
        && cmpClaveOk(n, v, 'a')
        && cmpClaveOk(n, v, 'b')
        && cmpClaveOk(n, v, 'c')
        && cmpClaveOk(n, v, 'd')
        && cmpClaveOk(n, v, 'e')
        && cmpClaveOk(n, v, 'f')
        && suma >= 0
        && suma <= 1;
    }

    // Plantillas: descargas de PDF y agregadas a la colección
    match /dashboard_events/{id} {
      allow create: if eventoValido(['plantilla_descargada', 'plantilla_biblioteca']);
      allow read: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Onboarding (experiencia mejorada)
    //   onboarding_completado  → se activó la experiencia mejorada
    //   onboarding_admin_uso   → uso del Admin y de cada botón Editar
    //   (onboarding_editado / onboarding_desactivado se mantienen
    //    permitidos por compatibilidad, hoy la app no los envía)
    match /dashboard_onboarding/{id} {
      allow create: if eventoValido([
        'onboarding_completado',
        'onboarding_editado',
        'onboarding_desactivado',
        'onboarding_admin_uso'
      ]);
      allow read: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Perfiles — DEPRECADO.
    // Reemplazado por dashboard_config/uso_contadores. Se deja habilitado
    // solo para que las APK ya instaladas no reciban errores; se puede
    // borrar este bloque cuando ya no queden versiones viejas en uso.
    match /dashboard_profiles/{id} {
      allow create: if eventoValido([
        'perfil_prueba_seleccionado',
        'perfil_prueba_activado',
        'perfil_real_creado'
      ]);
      allow read: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Uso / interacciones — DEPRECADO.
    // Reemplazado por dashboard_config/uso_contadores. Mismo criterio que
    // dashboard_profiles: se borra cuando ya no queden APK viejas.
    match /dashboard_interactions/{id} {
      allow create: if eventoValido([
        'paginacion_cambiada',
        'editor_abierto',
        'desplazamiento_cambiado'
      ]);
      allow read: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Likes / dislikes de diseños (los envía la app, los lee y borra el dashboard)
    match /dashboard_design_feedback/{id} {
      allow create: if disenoFeedbackValido(id);
      allow read: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // ============================================================
    // CONFIGURACIÓN (dashboard_config)
    //
    //   diseno_resets      marcas de "reiniciar me gusta / no me gusta".
    //                      Las escribe el dashboard (con sesión) y las leen
    //                      los teléfonos (sin sesión) por id, para borrar
    //                      sus respuestas guardadas y volver a preguntar.
    //
    //   diseno_contadores  { likes: { "CV-06": 4 }, dislikes: { "CV-06": 1 } }
    //                      La app solo SUMA votos; el dashboard lo lee (una
    //                      sola lectura) y lo reinicia.
    //
    //   uso_contadores     métricas de uso agregadas (ver bloque USO
    //                      AGREGADO más arriba). La app solo SUMA (create /
    //                      update, nunca delete); el dashboard lo lee (una
    //                      sola lectura) y lo reinicia.
    //
    //   distribucion       cómo se comparte la app (Ajustes > Compartir
    //                      aplicación). La app solo LEE; el dashboard escribe.
    //                      { modoDistribucion: "apk" | "play",
    //                        urlApk, urlPlay,
    //                        mensajeCompartir: { es, en, pt } }
    //                      También es el enlace que abre el botón "Actualizar
    //                      aplicación" de la pantalla de bloqueo.
    //
    //   versiones          control de versiones y bloqueo de la app. La app
    //                      solo LEE; el dashboard (pestaña Versiones) escribe.
    //                      { versiones: [
    //                          { version: "1.3.0",
    //                            lanzamiento: "2026-10-01",
    //                            vencimiento: "2027-09-30" }, ... ],
    //                        actualizadoEn }
    //                      La app usa la fecha de vencimiento de SU versión
    //                      (la de app.json) y la compara con la fecha del
    //                      teléfono. Las versiones vencidas se quedan acá
    //                      para que las APK viejas sigan bloqueadas.
    //
    //   versiones_historial archivo de versiones vencidas (pestaña Versiones,
    //                      sección Historial). Solo lo usa el dashboard: la
    //                      app NO lo lee ni lo escribe. Es un objeto (mapa
    //                      por versión), no una lista:
    //                      { registros: {
    //                          v_1_0_0: { version: "1.0.0",
    //                                     lanzamiento: "2026-01-15",
    //                                     vencimiento: "2026-06-30",
    //                                     archivadoEn: "2026-10-26" }, ... },
    //                        actualizadoEn }
    // ============================================================

    match /dashboard_config/diseno_resets {
      allow get: if true;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['resetTodoEn', 'resets', 'actualizadoEn'])
        && request.resource.data.get('resetTodoEn', 0) is number
        && request.resource.data.get('resets', {}) is map;

      allow delete: if request.auth != null;
    }

    match /dashboard_config/diseno_contadores {
      // Solo el dashboard lee
      allow get: if request.auth != null;

      // Dashboard (con sesión): cualquier cambio (reiniciar, recalcular)
      allow create, update, delete: if request.auth != null;

      // App (sin sesión): solo sumar votos
      // - primer voto: se crea el documento con un solo diseño en 1
      allow create: if
        (request.resource.data.keys().hasOnly(['likes'])
          && mapaUno(request.resource.data.likes))
        || (request.resource.data.keys().hasOnly(['dislikes'])
          && mapaUno(request.resource.data.dislikes));

      // - siguientes votos: cambia un solo diseño, de un solo mapa
      allow update: if request.resource.data.keys().hasOnly(['likes', 'dislikes'])
        && (
          (cambioUnDiseno(request.resource.data.get('likes', {}), resource.data.get('likes', {}))
            && request.resource.data.get('dislikes', {}) == resource.data.get('dislikes', {}))
          ||
          (cambioUnDiseno(request.resource.data.get('dislikes', {}), resource.data.get('dislikes', {}))
            && request.resource.data.get('likes', {}) == resource.data.get('likes', {}))
        );
    }

    // Métricas de uso agregadas.
    match /dashboard_config/uso_contadores {
      // Solo el dashboard lee
      allow get: if request.auth != null;

      // Dashboard (con sesión): cualquier cambio (reiniciar desde Historial)
      allow create, update, delete: if request.auth != null;

      // App (sin sesión): solo sumar, nunca borrar
      allow create: if usoCrearOk();
      allow update: if usoActualizarOk();
    }

    // Distribución de la app: la app (sin sesión) lee por id,
    // solo el dashboard (con sesión) escribe.
    match /dashboard_config/distribucion {
      allow get: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Control de versiones: la app (sin sesión) lee por id, solo el
    // dashboard (con sesión) escribe. Se acepta únicamente `versiones`
    // (lista, máx. 200 entradas) y `actualizadoEn`.
    match /dashboard_config/versiones {
      allow get: if true;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['versiones', 'actualizadoEn'])
        && request.resource.data.get('versiones', []) is list
        && request.resource.data.get('versiones', []).size() <= 200;

      allow delete: if request.auth != null;
    }

    // Historial de versiones vencidas: solo el dashboard (con sesión) lee y
    // escribe. La app no tiene acceso. Se acepta únicamente `registros`
    // (mapa, máx. 200 entradas) y `actualizadoEn`.
    match /dashboard_config/versiones_historial {
      allow get: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['registros', 'actualizadoEn'])
        && request.resource.data.get('registros', {}) is map
        && request.resource.data.get('registros', {}).size() <= 200;

      allow delete: if request.auth != null;
    }

    // ============================================================
    // MENSAJES PERSONALIZADOS
    //
    //   dashboard_mensajes_plantillas/{id}   mensajes guardados con nombre
    //       { nombre, modo, rico, actualizadoEn, creadoEn }
    //       Solo el dashboard (con sesión).
    //
    //   dashboard_mensajes_envios/{envioId}  registro de envíos masivos
    //       { nombre, modo, rico, chats: [ids], total, enviados, estado,
    //         enviadoEn, creadoEn, eliminadoEn? }
    //       Solo el dashboard (con sesión). La app NO lo usa.
    //
    //   dashboard_mensajes_compartidos/{id}  encuestas compartidas
    //       (ver bloque ENCUESTAS COMPARTIDAS más arriba)
    //
    //   dashboard_config/mensajes_modulos    interruptores
    //       { modulos: { texto, tarjeta, video, encuesta_likes,
    //                    encuesta_top }, mostrarDemo, actualizadoEn }
    //       La app (sin sesión) lee por id; el dashboard escribe.
    // ============================================================

    match /dashboard_mensajes_plantillas/{id} {
      allow read, delete: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(
            ['nombre', 'modo', 'rico', 'actualizadoEn', 'creadoEn'])
        && request.resource.data.keys().hasAll(['nombre', 'modo', 'rico'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.modo in ['texto', 'tarjeta', 'video', 'encuesta_likes', 'encuesta_top']
        && request.resource.data.rico is map
        && request.resource.data.rico.get('tipo', null) == request.resource.data.modo;
    }

    // Registro de mensajes enviados a VARIOS chats (para borrarlos de todos
    // con un botón). Cada envío se anota ANTES de mandarse; al borrarlo de
    // los chats el registro queda con estado "eliminado" hasta que se quita
    // de la lista.
    match /dashboard_mensajes_envios/{id} {
      allow read, delete: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(
            ['nombre', 'modo', 'rico', 'chats', 'total', 'enviados',
             'estado', 'enviadoEn', 'creadoEn', 'eliminadoEn'])
        && request.resource.data.keys().hasAll(
            ['nombre', 'modo', 'rico', 'chats', 'enviadoEn'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.modo in ['texto', 'tarjeta', 'video', 'encuesta_likes', 'encuesta_top']
        && request.resource.data.rico is map
        && request.resource.data.rico.get('tipo', null) == request.resource.data.modo
        && request.resource.data.chats is list
        && request.resource.data.chats.size() <= 2000
        && request.resource.data.get('estado', 'enviado') in ['enviando', 'enviado', 'parcial', 'eliminado'];
    }

    // Encuestas compartidas: la app (sin sesión) lee por id y solo mueve
    // votos; el dashboard (con sesión) puede todo.
    match /dashboard_mensajes_compartidos/{id} {
      allow get: if true;
      allow list: if request.auth != null;

      // Dashboard (con sesión): crear, editar, reiniciar contadores, borrar
      allow create, update, delete: if request.auth != null;

      // App (sin sesión): solo mover votos en `contadores`
      allow update: if cmpVotoOk();
    }

    match /dashboard_config/mensajes_modulos {
      allow get: if true;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['modulos', 'mostrarDemo', 'actualizadoEn'])
        && request.resource.data.get('modulos', {}) is map
        && request.resource.data.get('mostrarDemo', true) is bool;

      allow delete: if request.auth != null;
    }

    // ============================================================
    // CHAT DE AYUDA
    //
    //   chats/{userId}                  ficha del usuario (presencia)
    //   chats/{userId}/messages/{id}    mensajes de ambos lados
    //   chats/{userId}/limites/{dia}    contador de mensajes por día
    //
    // Campos de la ficha:
    //   Los escribe la APP:      creadoEn, ultimaVez (en el chat), enChat,
    //                            ultimaVezApp, enApp (dentro de la app),
    //                            plataforma, idioma, ultimoMensaje,
    //                            ultimoMensajeEn
    //   Los escribe el DASHBOARD: soporteLeyoHasta, ultimaRespuestaEn,
    //                            resetEn (la app los puede dejar igual,
    //                            nunca cambiarlos)
    // ============================================================

    match /chats/{userId} {

      function camposApp() {
        return ['creadoEn', 'ultimaVez', 'ultimaVezApp', 'enChat', 'enApp',
                'plataforma', 'idioma', 'ultimoMensaje', 'ultimoMensajeEn'];
      }

      function camposSoporte() {
        return ['soporteLeyoHasta', 'ultimaRespuestaEn', 'resetEn'];
      }

      // La app no puede tocar los campos del soporte
      function soporteIntacto() {
        return request.resource.data.get('soporteLeyoHasta', null) == resource.data.get('soporteLeyoHasta', null)
          && request.resource.data.get('ultimaRespuestaEn', null) == resource.data.get('ultimaRespuestaEn', null)
          && request.resource.data.get('resetEn', null) == resource.data.get('resetEn', null);
      }

      // Mensaje personalizado (solo lo manda el dashboard). Tres formas:
      //   1) sin `modo`, `rico` ni `refId`            -> texto simple
      //   2) `modo` + `rico` (sin `refId`)            -> texto, tarjeta, video
      //                                                  y encuestas VIEJAS
      //   3) `modo` de encuesta + `refId` (sin `rico`)-> encuesta compartida
      //                                                  (la definición y los
      //                                                  votos viven en
      //                                                  dashboard_mensajes_
      //                                                  compartidos)
      function ricoValido() {
        let d = request.resource.data;
        let sinExtras = !('modo' in d) && !('rico' in d) && !('refId' in d);
        let enMensaje = 'modo' in d
          && 'rico' in d
          && !('refId' in d)
          && d.modo in ['texto', 'tarjeta', 'video', 'encuesta_likes', 'encuesta_top']
          && d.rico is map
          && d.rico.get('tipo', null) == d.modo
          && d.rico.size() <= 8;
        let compartida = 'modo' in d
          && 'refId' in d
          && !('rico' in d)
          && d.modo in ['encuesta_likes', 'encuesta_top']
          && d.refId is string
          && d.refId.size() >= 1
          && d.refId.size() <= 60;
        return sinExtras || enMensaje || compartida;
      }

      // Traducciones de un mensaje simple del soporte: { es, en, pt }
      function idiomaOk() {
        let d = request.resource.data;
        return !('idioma' in d)
          || (d.idioma is map && d.idioma.keys().hasOnly(['es', 'en', 'pt']));
      }

      // La app lee solo SU ficha (por id). Listar todos: solo el dashboard.
      allow get: if true;
      allow list: if request.auth != null;

      // La app crea su ficha
      allow create: if request.resource.data.keys().hasOnly(camposApp())
        && userId.size() >= 10 && userId.size() <= 60;

      // La app actualiza su ficha (sin tocar los campos del soporte)
      allow update: if request.resource.data.keys().hasOnly(camposApp().concat(camposSoporte()))
        && soporteIntacto();

      // Dashboard (con sesión): cualquier campo
      allow create, update: if request.auth != null;

      // Solo el dashboard puede borrar
      allow delete: if request.auth != null;

      // Mensajes
      match /messages/{mensajeId} {
        allow read: if true;

        // Del usuario (app): máx. 500 caracteres y máx. 10 por día
        allow create: if request.resource.data.keys().hasOnly(
              ['de', 'texto', 'enviadoEn', 'dia', 'createdAt'])
          && request.resource.data.keys().hasAll(
              ['de', 'texto', 'enviadoEn', 'dia', 'createdAt'])
          && request.resource.data.de == 'usuario'
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 500
          && request.resource.data.enviadoEn is number
          && request.resource.data.dia is string
          && request.resource.data.dia.size() == 10
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/chats/$(userId)/limites/$(request.resource.data.dia)).data.count <= 10;

        // Tuyos (dashboard con sesión): sin límite diario
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(
              ['de', 'texto', 'enviadoEn', 'createdAt', 'modo', 'rico', 'refId', 'idioma'])
          && request.resource.data.keys().hasAll(
              ['de', 'texto', 'enviadoEn'])
          && ricoValido()
          && idiomaOk()
          && request.resource.data.de == 'soporte'
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 2000
          && request.resource.data.enviadoEn is number;

        // Editar tus propios mensajes (dashboard con sesión):
        // solo los de 'soporte'. Se puede cambiar el texto (y sus
        // traducciones en `idioma`) y se marca
        // con editadoEn. El autor, las fechas originales, `modo`, `rico` y
        // `refId` no se tocan.
        allow update: if request.auth != null
          && resource.data.de == 'soporte'
          && request.resource.data.de == 'soporte'
          && request.resource.data.keys().hasOnly(
              ['de', 'texto', 'enviadoEn', 'createdAt', 'editadoEn', 'modo', 'rico', 'refId', 'idioma'])
          && request.resource.data.keys().hasAll(
              ['de', 'texto', 'enviadoEn', 'editadoEn'])
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 2000
          && request.resource.data.enviadoEn == resource.data.enviadoEn
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && request.resource.data.get('modo', null) == resource.data.get('modo', null)
          && request.resource.data.get('rico', null) == resource.data.get('rico', null)
          && request.resource.data.get('refId', null) == resource.data.get('refId', null)
          && request.resource.data.editadoEn is number
          && idiomaOk();

        allow delete: if request.auth != null;
      }

      // Contador diario: solo sube de a 1 y hasta 10
      match /limites/{dia} {
        allow read: if request.auth != null;

        allow create: if request.resource.data.keys().hasOnly(['count', 'dia'])
          && request.resource.data.count == 1
          && request.resource.data.dia == dia;

        allow update: if request.resource.data.keys().hasOnly(['count', 'dia'])
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.count <= 10
          && request.resource.data.dia == dia;

        allow delete: if request.auth != null;
      }
    }
  }
}